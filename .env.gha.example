# ============================================================================
# Secrets e variáveis do GitHub Actions — exemplo
# ============================================================================
# Estes NÃO são variáveis de um .env local: são configurações do repositório no
# GitHub (Settings → Secrets and variables → Actions). O nome deve bater
# exatamente com a chave abaixo; os workflows os leem via `${{ secrets.NOME }}`
# ou `${{ vars.NOME }}`.
#
# Marcações: [obrigatório p/ X] = sem ele o job X falha;
#            [opcional] = sem ele o passo é pulado e o job ainda passa.

# ----------------------------------------------------------------------------
# Publicação no npm (job publish-npm, environment `npm`)
# ----------------------------------------------------------------------------
# O caminho preferido é o trusted publishing (OIDC): cadastre o repositório e o
# workflow `vext.yml` como publisher de cada pacote @vext/* no npm e não use
# token nenhum. NPM_TOKEN é só o fallback do primeiro publish de um pacote novo
# (o trusted publishing exige o pacote já existente). Depois remova o secret.
# [opcional — sem ele a publicação usa o trusted publishing]
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Publicação no PyPI (job publish-pypi, environment `pypi`)
# ----------------------------------------------------------------------------
# Usa trusted publishing: cadastre o publisher no PyPI (repositório, workflow
# `vext.yml`, environment `pypi`). Não há token. O job só roda quando a
# variável de repositório PUBLISH_PYPI é "true".
# [opcional — variável de repositório, não secret]
PUBLISH_PYPI=false

# ----------------------------------------------------------------------------
# Release automatizado (Release Please e rotação de linhas)
# ----------------------------------------------------------------------------
# Token com permissão de abrir PRs e criar tags/releases neste repositório.
# [opcional — sem ele os workflows usam o GITHUB_TOKEN, e os PRs de release
# não disparam os checks]
RELEASE_PLEASE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
